# PDF Master Pro — API environment variables
# Copy to .env and fill in real values before deploying.

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
# Your deployed web app's URL — used to build Stripe checkout success/cancel/portal return links.
APP_BASE_URL=http://localhost:8080

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Storage ---
STORAGE_DIR=./storage
# Set S3_ENABLED=true and fill these in to move off local disk in production.
S3_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Plans / quotas ---
MAX_FILE_SIZE_MB_FREE=25
MAX_FILE_SIZE_MB_PRO=500
FREE_JOB_EXPIRY_HOURS=2
PRO_JOB_EXPIRY_HOURS=24
FREE_DAILY_OPS=5

# --- AI features (AI Summary / Chat with PDF) ---
# provider: openai | anthropic | gemini | none
LLM_PROVIDER=none
LLM_API_KEY=

# --- Stripe billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# --- Binaries (override only if not on PATH) ---
QPDF_PATH=qpdf
GS_PATH=gs
PDFTOPPM_PATH=pdftoppm
PDFTOCAIRO_PATH=pdftocairo
TESSERACT_PATH=tesseract
LIBREOFFICE_PATH=soffice
